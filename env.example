# Copia este archivo como ".env" (o configura estas variables en tu proveedor de hosting)
PORT=3000

# Cambia esto por un texto largo y aleatorio propio — protege las sesiones de inicio de sesión
SESSION_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio

# Solo necesario en producción (Render, Railway, etc). Si la dejas vacía o la
# eliminas, la app funciona igual pero guardando todo en archivos locales
# dentro de /data y /uploads (útil para probar en tu computador).
# Instrucciones para conseguir esta URL gratis: ver README.md, sección 2.
MONGODB_URI=

# Actívalo en producción para forzar HTTPS y cookies seguras.
NODE_ENV=production

# Clave maestra de recuperación de cuentas. Si alguien (especialmente el director)
# olvida su clave, puede resetearla desde "¿Olvidaste tu clave?" en el login usando
# este valor. IMPORTANTE: si no la configuras, la recuperación queda desactivada
# — no hay valor por defecto, a propósito. Guárdala en un lugar seguro FUERA de la
# app (un gestor de claves, un papel guardado bajo llave), nunca en este archivo
# ni en el código.
RECOVERY_SECRET=

